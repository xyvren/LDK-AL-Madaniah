# =============================================================================
# .env.production — Template untuk Railway
# Salin nilai dari Railway Dashboard → Service → Variables
# Jangan commit file ini — hanya sebagai panduan.
# =============================================================================

# ----- Aplikasi -----
APP_NAME="LDK Al-Madaniah UBB"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app
SANCTUM_TOKEN_EXPIRATION=10080

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ----- Database (MySQL — Railway menyediakan variabel ini otomatis) -----
# ⚠️  Railway MySQL plugin menghasilkan MYSQL_URL, bukan DB_HOST/DB_PORT individual.
#     Script startCommand di bawah mem-parsing MYSQL_URL → DB_HOST / DB_PORT / DB_DATABASE / DB_USERNAME / DB_PASSWORD.
DB_CONNECTION=mysql
DB_HOST=railway-db-host.internal
DB_PORT=3306
DB_DATABASE=railway_database_name
DB_USERNAME=railway_username
DB_PASSWORD=railway_password

# ----- Broadcast / Cache / Session -----
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=public
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# ----- Redis (opsional — uncomment jika menambahkan plugin Redis) -----
# REDIS_HOST=redis.railway.internal
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ----- Mail: Brevo SMTP -----
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_login_email
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="LDK Al-Madaniah"

BREVO_API_KEY=xkeysib-your-brevo-api-key

# ----- Mail: Gmail SMTP (transaksional) -----
GMAIL_HOST=smtp.gmail.com
GMAIL_PORT=587
GMAIL_ENCRYPTION=tls
GMAIL_USERNAME=noreplyldksyahid@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
GMAIL_FROM_ADDRESS=noreplyldksyahid@gmail.com
GMAIL_FROM_NAME="LDK Al-Madaniah"

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://your-app.up.railway.app/auth/google/callback

# ----- Google Drive -----
GOOGLE_DRIVE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_DRIVE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token
GOOGLE_DRIVE_FOLDER_ID=your_folder_id
GDRIVE_DYNAMIC_FORM_ROOT_FOLDER_ID=your_root_folder_id

# ----- Xendit -----
SECRET_KEY_XENDIT=your_xendit_secret
XENDIT_WEBHOOK_TOKEN=your_webhook_token

# ----- BisaTopup -----
BISATOPUP_USERNAME=your_username
BISATOPUP_PASSWORD_API=your_api_password
BISATOPUP_WIDGET_KEY=your_widget_key
BISATOPUP_ENV=dev
BISATOPUP_BASE_URL_LIVE=https://api.bisabiller.com
BISATOPUP_BASE_URL_DEV=https://api-sandbox.bisabiller.com
BISATOPUP_QRIS_PAYMENT_ID=33
BISATOPUP_ADMIN_FEE_PERCENT=1
BISATOPUP_ENFORCE_CALLBACK_SIGNATURE=false
BISATOPUP_CALLBACK_DISBURSEMENT_SECRET=random_32char_string_here
BISATOPUP_ALLOWED_IPS=

# ----- 2FA Withdrawal -----
TWO_FA_ALLOWED_USERS=admin@yourdomain.com
TWO_FA_APP_NAME="LDK Al-Madaniah Admin"
TWO_FA_DISCREPANCY_THRESHOLD=50000

# ----- WhatsApp (Kirimdev) -----
WHATSAPP_RATE_PER_MINUTE=8
KIRIMDEV_API_KEY=your_kirimdev_key
KIRIMDEV_PHONE_NUMBER_ID=your_phone_number_id
KIRIMDEV_BASE_URL=https://api.kirimdev.com/v1
KIRIMDEV_TEMPLATE_LANGUAGE=id
KIRIMDEV_WEBHOOK_SECRETS=

# ----- reCAPTCHA Enterprise -----
RECAPTCHA_TYPE=score
RECAPTCHA_SITE_KEY=your_site_key
RECAPTCHA_API_KEY=your_api_key
RECAPTCHA_PROJECT_ID=your_project_id
RECAPTCHA_SCORE_THRESHOLD=0.5
RECAPTCHA_ENABLED=true

# ----- SweetAlert -----
SWEET_ALERT_TIMER=6000

# ----- GIPHY -----
GIPHY_API_KEY=your_giphy_key

# ----- App Port (Railway menentukan ini otomatis) -----
PORT=8000
